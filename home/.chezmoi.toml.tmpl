{{/* one axis: workstations get secrets + GUI tooling, servers get neither */}}
{{- $server := promptBoolOnce . "server" "Is this machine a headless server"}}
{{- $wsl := (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) -}}

[data]
    server = {{ $server }}
    wsl = {{ $wsl }}

[merge]
command = "bash"
args = [
    "-c",
    '{{ "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }}',
]

{{- if not $server }}
[edit]
    command = "code"
    args = ["--wait", "-n"]
{{- end }}
