{{- /* chezmoi:modify-template */ -}}
{{- $s := .chezmoi.stdin | fromJson -}}
{{- $env := or (get $s "env") dict -}}
{{- range list "GIT_CONFIG_COUNT" "GIT_CONFIG_KEY_0" "GIT_CONFIG_VALUE_0" "GIT_CONFIG_KEY_1" "GIT_CONFIG_VALUE_1" -}}
{{-   $_ := unset $env . -}}
{{- end -}}
{{- if $env -}}
{{-   $_ := set $s "env" $env -}}
{{- else -}}
{{-   $_ := unset $s "env" -}}
{{- end -}}
{{- $attr := or (get $s "attribution") dict -}}
{{- $_ := set $attr "commit" "" -}}
{{- $_ := set $attr "pr" "" -}}
{{- $_ := set $attr "sessionUrl" false -}}
{{- $_ := set $s "attribution" $attr -}}
{{ $s | toPrettyJson }}