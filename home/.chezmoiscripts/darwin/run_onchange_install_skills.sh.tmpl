#!/bin/sh

# Restore global agent skills into ~/.agents/skills/ from two sources:
#
#   1. Community skills, from ~/.agents/.skill-lock.json.
#      WORKAROUND for the skills CLI lacking a global-lockfile restore
#      command: `experimental_install` reads only the project-scoped
#      skills-lock.json (verified in v1.5.26). Until that lands upstream
#      we rehydrate by re-issuing `skills add <source> -g -s <name>`.
#      Upstream issue: https://github.com/vercel-labs/skills/issues/683
#
#   2. Personal skills, from the chezmoi-managed ~/.agents/my-skills/.
#      The CLI deliberately skips recording local-path installs in the
#      global lockfile, so GLOBAL_MY_SKILLS below is their manifest.
#
# Personal skills NOT listed in GLOBAL_MY_SKILLS (e.g. dev-loop,
# unity-cli) are project-scoped: inside a project run
#   npx skills add ~/.agents/my-skills -s <name>
# then commit the project's skills-lock.json and restore it anywhere
# with `npx skills experimental_install`.

# Re-run triggers (chezmoi re-runs this script when these hashes change):
# .skill-lock.json hash: {{ include "dot_agents/dot_skill-lock.json" | sha256sum }}
# my-skills hashes (known limitation: only *.md files are hashed):
{{- range glob (joinPath .chezmoi.sourceDir "dot_agents/exact_my-skills/**/*.md") }}
# {{ . }}: {{ include . | sha256sum }}
{{- end }}

set -eu

SKILLS_CLI="skills@1.5.26"

GLOBAL_MY_SKILLS="
codebase-design
domain-modeling
grill-me
grill-with-docs
grilling
improve-codebase-architecture
my-voice
orchestrator
to-spec
to-tickets
wayfinder
"

log() {
  printf '[restore-skills] %s\n' "$*" >&2
}

if ! command -v npx >/dev/null 2>&1; then
  printf '%s\n' "npx is required (install Node.js)." >&2
  exit 1
fi

LOCK="{{ joinPath .chezmoi.homeDir ".agents" ".skill-lock.json" }}"
MY_SKILLS_DIR="{{ joinPath .chezmoi.homeDir ".agents" "my-skills" }}"

# clean slate
log "removing existing skills in ~/.agents/skills/"
rm -rf {{ joinPath .chezmoi.homeDir ".agents" "skills" }}

# --- 1. community skills from the global lockfile -----------------------

if [ -f "$LOCK" ]; then
  # Snapshot the lockfile before invoking the CLI: every successful
  # `skills add` rewrites .skill-lock.json with a fresh `updatedAt`. We
  # only want the file content side-effect (skills materialised into
  # ~/.agents/skills/), not the timestamp churn — the lockfile is the
  # source of truth we're honouring, not modifying. Restore on EXIT so
  # the snapshot wins even on Ctrl-C or mid-loop failure.
  SNAPSHOT=$(mktemp)
  trap 'cp "$SNAPSHOT" "$LOCK" && rm -f "$SNAPSHOT"' EXIT INT TERM
  cp "$LOCK" "$SNAPSHOT"

  # Group skills by source so every skill sharing a source installs with
  # a single `skills add` invocation:
  #   npx skills add -g -y SOURCE -s NAME1 -s NAME2
  while read -r source names <&3; do
    set -- add -g -y "$source"
    for name in $names; do
      set -- "$@" -s "$name"
    done
    log "installing from $source: $names"
    npx "$SKILLS_CLI" "$@"
  done 3<<EOF
$(jq -r '
  .skills
  | to_entries
  | group_by(.value.source)[]
  | (.[0].value.source) + " " + ([.[].key] | join(" "))
' "$LOCK")
EOF
else
  log "no .skill-lock.json at $LOCK, skipping community skills"
fi

# --- 2. personal skills from ~/.agents/my-skills ------------------------

set -- add -g -y "$MY_SKILLS_DIR"
for name in $GLOBAL_MY_SKILLS; do
  set -- "$@" -s "$name"
done
log "installing personal skills from $MY_SKILLS_DIR"
npx "$SKILLS_CLI" "$@"
